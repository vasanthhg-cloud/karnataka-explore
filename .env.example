# Copy this file to .env and edit the values. Never commit .env.

# A long random string - used to sign session cookies.
SECRET_KEY=change-this-to-a-long-random-string

# sqlite (default, zero setup) or mysql
DB_BACKEND=sqlite
SQLITE_PATH=instance/karnataka_explore.db

# Only used when DB_BACKEND=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=karnataka_explore

# Site details
SITE_NAME=Karnataka Explore
CONTACT_EMAIL=hello@karnatakaexplore.in
CONTACT_PHONE=+91 80 2222 3344

# Accounts created by seed.py - change these before deploying anything real
DEFAULT_ADMIN_EMAIL=admin@karnatakaexplore.in
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_DEMO_USER_EMAIL=demo@karnatakaexplore.in
DEFAULT_DEMO_USER_PASSWORD=Demo@1234
